# Adapted from 2Retr0/GodotOceanWaves (MIT); see THIRD_PARTY_LICENSES.
class_name NyaWaveGenerator extends Node
## Handles the compute pipeline for wave spectra generation/FFT.

const G := 9.81
const DEPTH := 20.0

signal cascade_updated(grid_index: int)

var map_size: int = 256
var gpu_ready := false
var context : NyaRenderingContext
var pipelines : Dictionary
var descriptors : Dictionary

